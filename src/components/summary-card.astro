---
import '../styles/global.css'

interface Props {
  game: {
    id: string;
    data: {
        year: string;
    }
  };
}
const { game } = Astro.props;
const { year } = game.data;
const BASE_URL = import.meta.env.BASE_URL;

---

<a href={`${BASE_URL}summaries/${game.id}/`} class="summary-card">
    <div class="info">
        <h1>{year}</h1>
    </div>
</a>
