---
import '../styles/global.css'

import { Image } from 'astro:assets';
import hg_logo from '../../public/hg_logo.png';

const version = import.meta.env.PUBLIC_APP_VERSION || 'dev';
---

<div class="head">
    <div class="head_wrapper">
        <span class="head_version">v{version}</span>
        <div class="head_bar">
            <a href="/hinogames-log/">
                <Image src={hg_logo} alt="HinoGamesLog" width="1500" height="597" class="head_logo"/>
            </a>
        </div>
    </div>
</div>