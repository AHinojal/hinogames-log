---
import '../styles/global.css'
import YearsNavbar from './years-navbar.astro';

interface Props {
  listYears: Set<number>
}

enum Options {
  REVIEWS = "HISTÓRICO",
  SUMMARIES = "RESUMEN",
  //MENTIONS = "MENCIONES HINORÍFICAS"
}

const { listYears } = Astro.props;
const LIST_OPTIONS = Object.values(Options) ;
---

<div class="option-navbar">
	<ul class="list-options">
		{LIST_OPTIONS.map((option) => (
			<li data-option={option}>{option}</li>
		))}
	</ul>
</div>
<div class="years-navbar">
	<YearsNavbar listYears={listYears}></YearsNavbar>
</div>

<script>
	function updateSelectedOptionStyle(selectedOption: string) {
		options.forEach((option) => {
			if (option.dataset.option === selectedOption) {
				option.classList.add('selected');
			} else {
				option.classList.remove('selected');
			}
		});
	}
	function updateVisibleYearsNavbar(yearsNavbar: any) {
		if (selectedOption === 'HISTÓRICO') {
			yearsNavbar.style.display = '';
		} else{
			yearsNavbar.style.display = 'none';
		}
	}	
	// Seleccionamos todos los span de los años
	const options = document.querySelectorAll<HTMLElement>('.list-options li');
	console.log("🚀 ~ options:", options)
	const yearsNavbar = document.querySelector<HTMLElement>('.years-navbar');
	console.log("🚀 ~ yearsNavbar:", yearsNavbar)
	// Mostramos como estado inicial el historial
	let selectedOption: string = 'HISTÓRICO';
	updateSelectedOptionStyle(selectedOption);
	updateVisibleYearsNavbar(yearsNavbar);
	// Por cada opcion, tenemos que escuchar el evento si el boton es pulsado
	options.forEach((option) => {
		option.addEventListener('click', () => {
			// // Guardamos el año seleccionado
			selectedOption = option.dataset.option || 'HISTÓRICO';
			console.log("🚀 ~ selectedOption:", selectedOption)
			// // Buscamos entre las cartas que tenemos y elegimos su visiblidad
			updateSelectedOptionStyle(selectedOption);
			updateVisibleYearsNavbar(yearsNavbar);
		});
	});
</script>