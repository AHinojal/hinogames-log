---
import '../styles/global.css'

import { getCollection } from 'astro:content';

import Card from '../components/card.astro';
import Head from '../components/head.astro';
import Header from '../components/header.astro';
import Navbar from '../components/navbar.astro';

const reviews = await getCollection('reviews', (review) => !review.data.isDraft);
const listYears: Set<number> = new Set();
const sortedReviews = reviews.sort((a, b) => a.data.finishedAt.getTime() - b.data.finishedAt.getTime());
sortedReviews.map((r) => listYears.add(r.data.finishedAt.getFullYear()));
---

<html lang="es">
	<head>
		<Head/>
	</head>
	<body>
		<Header></Header>
		<div class="navbar">
			<Navbar listYears={listYears}></Navbar>
		</div>
		<div class="list-games">
			{sortedReviews.map((game) => (
					<Card game={game}></Card>
				))
			}
		</div>
	</body>
</html>
