---
import '../styles/global.css'

import { Image } from 'astro:assets';

import Head from '../components/head.astro'
import Subheader from '../components/subheader.astro';

const BASE_URL = import.meta.env.BASE_URL;
const star = `${BASE_URL}/summary.svg`;

interface Props {
  data: {
    title: string;
  };
}

const { title } = Astro.props.data;
---

<html lang="es">
  <head>
    <Head title={`${title} — HinoGames`}></Head>
  </head>
	<body>
    <Subheader></Subheader>
    <div class="container">
      <header class="summary-header">
        <div class="title">
          <div class="stars">
            <span class="star" style={`--icon: url(${star})`}></span>
            <span class="star" style={`--icon: url(${star})`}></span>
            <span class="star" style={`--icon: url(${star})`}></span>
          </div>
          <h1>{title}</h1>
          <div class="stars">
            <span class="star" style={`--icon: url(${star})`}></span>
            <span class="star" style={`--icon: url(${star})`}></span>
            <span class="star" style={`--icon: url(${star})`}></span>
          </div>
        </div>
      </header>

      <article class="summary-body">
        <!-- Donde se inyecta el Content pasado por el padre -->
        <slot /> 
      </article>
    </div>
	</body>
</html>
